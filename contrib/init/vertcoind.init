#!/usr/bin/env bash
#
#  vertcoind The vertcoin core server.
#
#
# chkconfig: 345 80 20
# description: vertcoind
# processname: vertcoind
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/vertcoind, see below
if [ -f /etc/sysconfig/vertcoind ]; then
        . /etc/sysconfig/vertcoind
fi

RETVAL=0

prog=vertcoind
# you can override the lockfile via BITCOIND_LOCKFILE in /etc/sysconfig/vertcoind
lockfile=${BITCOIND_LOCKFILE-/var/lock/subsys/vertcoind}

# vertcoind defaults to /usr/bin/vertcoind, override with BITCOIND_BIN
vertcoind=${BITCOIND_BIN-/usr/bin/vertcoind}

# vertcoind opts default to -disablewallet, override with BITCOIND_OPTS
bitcoind_opts=${BITCOIND_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $vertcoind $bitcoind_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog -t600
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
